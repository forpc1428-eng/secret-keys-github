{
  "manifest_version": 3,
  "name": "Secret Keys",
  "version": "10.0.0",
  "description": "Custom hotkeys, macros and a command palette for every website — in a liquid glass UI. By Vedant.",
  "permissions": ["storage", "tabs", "bookmarks", "scripting", "clipboardWrite", "clipboardRead", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Secret Keys (Alt+Shift+K)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "open-palette": {
      "suggested_key": { "default": "Alt+K" },
      "description": "Open the command palette"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Show / hide the Secret Keys panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/dom.js",
        "content/store.js",
        "content/actions.js",
        "content/styles.js",
        "content/ui.js",
        "content/palette.js",
        "content/hints.js",
        "content/explore.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
